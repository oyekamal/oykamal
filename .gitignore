
# Enhanced .gitignore for web development projects

# Operating System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Editor and IDE files
.vscode/settings.json
.vscode/launch.json
.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# Development and build files
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
dist/
build/
*.log
.cache/
.parcel-cache/

# Environment and configuration files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
config.local.js

# Dependency directories
bower_components/
vendor/

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage and testing
coverage/
.nyc_output/
test-results/
.coverage

# Temporary files
*.tmp
*.temp
.tmp/
.temp/

# Backup files
*.bak
*.backup

# Compressed files
*.zip
*.tar.gz
*.rar

# Application specific
uploads/
public/uploads/
assets/images/originals/

# Lighthouse CI reports
.lighthouseci/

# Performance monitoring
web-vitals.json

# Ignore vscode AI rules
.github/instructions/codacy.instructions.md
